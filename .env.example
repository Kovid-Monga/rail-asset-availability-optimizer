# ============================================================
#  THE ONLY PLACE YOU CONFIGURE THE BACKEND
# ============================================================
# mock = use src/data/mockData.ts through src/api/mockApi.ts
# live = call the real backend via src/api/liveApi.ts
VITE_DATA_SOURCE=mock

# Base URL of your teammates' backend (no trailing slash).
VITE_API_BASE_URL=http://localhost:8000

# Simulated live operational events (mock mode only).
VITE_ENABLE_LIVE_SIMULATION=true
